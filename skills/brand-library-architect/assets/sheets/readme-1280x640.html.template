<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{PRODUCT_NAME}} — README Hero Banner</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{GOOGLE_FONTS_URL}}" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  background: #1a1d24;
  font-family: '{{BODY_FONT}}', sans-serif;
  padding: 40px 0;
  display: flex; flex-direction: column;
  align-items: center; gap: 56px;
}
.sheet-label {
  font-family: '{{MONO_FONT}}', monospace;
  font-size: 12px; color: {{BRAND_LIGHT_HEX}};
  letter-spacing: 2px; text-transform: uppercase;
  padding: 6px 14px;
  border: 1px solid rgba({{BRAND_LIGHT_RGB}}, 0.3);
  border-radius: 4px;
  background: rgba(10, 12, 16, 0.5);
  margin-bottom: 12px;
}
.sheet-item { display: flex; flex-direction: column; align-items: center; }

body.render { padding: 0; gap: 0; background: {{DARK_BG}}; }
body.render .sheet-label { display: none; }
body.render .sheet-item { margin: 0; }
body.render .sheet-item.hidden { display: none; }

/* ─────────────────────────────────────────────────────────────
   #readme-dark  ·  1280×640  ·  GitHub README hero (dark)
   ───────────────────────────────────────────────────────────── */
#readme-dark {
  width: 1280px; height: 640px;
  background: {{DARK_BG}};
  position: relative; overflow: hidden;
}
#readme-dark::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 70% 80% at 25% 50%,
    rgba({{BRAND_LIGHT_RGB}}, 0.15) 0%, rgba({{BRAND_PRIMARY_RGB}}, 0.05) 40%, transparent 70%);
  pointer-events: none;
}
#readme-dark::after {
  content: ''; position: absolute; inset: 0; opacity: 0.35;
  background-image:
    linear-gradient(rgba({{BRAND_LIGHT_RGB}}, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba({{BRAND_LIGHT_RGB}}, 0.025) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
}
#readme-dark .frame {
  position: relative; height: 100%;
  padding: 72px 80px;
  display: grid;
  grid-template-columns: 460px 1fr;
  gap: 64px;
  align-items: center;
  z-index: 1;
}
#readme-dark .left {
  display: flex; flex-direction: column;
  align-items: flex-start; gap: 28px;
  position: relative;
}
#readme-dark .gem-large { filter: drop-shadow(0 6px 18px rgba({{BRAND_LIGHT_RGB}}, 0.25)); }
#readme-dark .wordmark {
  font-family: '{{WORDMARK_FONT}}', Georgia, serif;
  font-weight: 400; font-size: 88px;
  color: {{DARK_TEXT}}; letter-spacing: 2.5px;
  line-height: 1;
}
#readme-dark .badge-row {
  display: flex; align-items: center; gap: 10px;
  font-family: '{{MONO_FONT}}', monospace;
  font-size: 11px; color: {{ACCENT_HEX}};
  letter-spacing: 2.5px; text-transform: uppercase;
  opacity: 0.75;
}
#readme-dark .badge-row .dot {
  width: 5px; height: 5px;
  border-radius: 50%;
  background: {{BRAND_LIGHT_HEX}};
  box-shadow: 0 0 6px rgba({{BRAND_LIGHT_RGB}}, 0.5);
}

#readme-dark .right {
  display: flex; flex-direction: column;
  gap: 24px;
  border-left: 1px solid rgba({{BRAND_LIGHT_RGB}}, 0.18);
  padding-left: 56px;
}
#readme-dark .eyebrow {
  font-family: '{{MONO_FONT}}', monospace;
  font-size: 11px; color: {{ACCENT_HEX}};
  letter-spacing: 3px; text-transform: uppercase;
  opacity: 0.65;
}
#readme-dark .headline {
  font-family: '{{DISPLAY_FONT}}', sans-serif;
  font-weight: 200; font-size: 50px;
  color: {{DARK_TEXT}}; letter-spacing: -0.6px;
  line-height: 1.05;
}
#readme-dark .headline em {
  font-family: '{{WORDMARK_FONT}}', Georgia, serif;
  font-style: italic; font-weight: 400;
  color: {{BRAND_LIGHT_HEX}};
}
#readme-dark .trust-row {
  display: flex; align-items: center; gap: 12px;
  margin-top: 8px;
  padding-top: 18px;
  border-top: 1px solid rgba({{BRAND_LIGHT_RGB}}, 0.12);
}
#readme-dark .trust {
  font-family: '{{MONO_FONT}}', monospace;
  font-size: 12px; color: {{BRAND_LIGHT_HEX}};
  letter-spacing: 2px; text-transform: uppercase;
  opacity: 0.85;
}
#readme-dark .trust .sep { opacity: 0.5; margin: 0 6px; }
#readme-dark .url {
  margin-left: auto;
  font-family: '{{MONO_FONT}}', monospace;
  font-size: 12px; color: {{ACCENT_HEX}};
  letter-spacing: 2px;
  opacity: 0.85;
}
</style>
</head>
<body>

<!--
  README hero · 1280×640 (2:1) banner sized for GitHub repo README top-of-page.
  Asymmetric layout: large mark + wordmark on left, locked hero copy + trust line
  on right, divided by thin vertical rule. Differentiates from og-image (centered).
-->

<!-- ─── README · DARK ─── -->
<div class="sheet-item">
  <div class="sheet-label">#readme-dark · 1280×640</div>
  <div id="readme-dark">
    <div class="frame">
      <div class="left">
        <svg class="gem-large" width="120" height="174" viewBox="0 0 22 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          {{MARK_SVG_DARK}}
        </svg>
        <span class="wordmark">{{PRODUCT_NAME}}</span>
        <div class="badge-row">
          <span class="dot"></span>
          <span>{{LICENSE_BADGE_LABEL}}</span>
        </div>
      </div>

      <div class="right">
        <div class="eyebrow">{{EYEBROW_TEXT}}</div>
        <h1 class="headline">{{LOCKED_HERO_NOUN}}<br><em>{{LOCKED_HERO_VERB}}</em></h1>
        <div class="trust-row">
          <span class="trust">{{TRUST_LINE}}</span>
          <span class="url">{{DOMAIN}}</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ─── README · LIGHT ─── -->
<!-- Duplicate dark variant, swap colors -->

<script>
  (function() {
    const hash = window.location.hash.slice(1);
    if (!hash) return;
    document.body.classList.add('render');
    const target = document.getElementById(hash);
    if (!target) return;
    const targetItem = target.closest('.sheet-item');
    document.querySelectorAll('.sheet-item').forEach(item => {
      if (item !== targetItem) item.classList.add('hidden');
    });
  })();
</script>

</body>
</html>
